{
  "name": "crm-ac",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "check:glossary": "bun run scripts/check-glossary.ts",
    "check:ui": "bun run scripts/check-ui-guardrails.ts",
    "check": "bun run typecheck && bun run check:glossary && bun run check:ui && bun run build",
    "taste:check": "node .agents/skills/design-taste-frontend/scripts/gate.mjs --start http://localhost:3000",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply crm-ac-db --local",
    "db:seed": "wrangler d1 execute crm-ac-db --local --file=./drizzle/seed.sql",
    "db:seed:remote": "wrangler d1 execute crm-ac-db --remote --file=./drizzle/seed.sql",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "better-auth": "^1.1.18",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.39.3",
    "hono": "^4.7.2",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.475.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.4",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wrangler": "^4.166.0"
  }
}
